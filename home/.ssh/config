# Machine-local hosts go in ~/.ssh/config.local (not committed).
Include config.local

# Port 22 is blocked on some networks; GitHub serves SSH on 443 too.
Host github.com
  HostName ssh.github.com
  Port 443
  User git

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
