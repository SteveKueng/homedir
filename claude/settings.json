{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:francisaugusto.com)",
      "WebFetch(domain:support.apple.com)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(ls -t \"$HOME\"/.claude/plugins/cache/ponytail/ponytail/*/hooks/ponytail-statusline.sh 2>/dev/null | head -1)\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "theme": "dark"
}
